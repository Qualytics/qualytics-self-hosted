################################################################################
# Qualytics AlloyDB for PostgreSQL - Example Configuration
#
# Copy this file to terraform.tfvars and customize for your deployment.
# Run terraform/gcp/cluster first — this module reads the project and VPC
# network from that state automatically.
################################################################################

#-------------------------------------------------------------------------------
# General
# cluster_name, region and tfstate_bucket must match the values used in
# terraform/gcp/cluster
#-------------------------------------------------------------------------------

region         = "us-central1"
cluster_name   = "qualytics"
tfstate_bucket = "<your-tfstate-bucket>"

default_labels = {
  terraform   = "true"
  application = "qualytics"
  environment = "production"
}

#-------------------------------------------------------------------------------
# Database
#-------------------------------------------------------------------------------

database_name       = "surveillance_hub"
administrator_login = "postgres"
postgresql_version  = "17"

#-------------------------------------------------------------------------------
# Instance
# cpu_count = 2  —  16 GB  (development / small production)
# cpu_count = 4  —  32 GB  (medium production)
# cpu_count = 8  —  64 GB  (large production)
#
# REGIONAL keeps an HA standby in a second zone (roughly doubles instance cost).
# Use ZONAL for non-production environments.
#-------------------------------------------------------------------------------

cpu_count         = 2
availability_type = "REGIONAL"

#-------------------------------------------------------------------------------
# Private Services Access
# Internal range reserved on the VPC for AlloyDB. Leave psa_address unset to let
# Google pick an unused range, or pin it to stay clear of networks you peer with
# or reach over VPN.
#-------------------------------------------------------------------------------

psa_prefix_length = 16
# psa_address     = "10.20.0.0"

#-------------------------------------------------------------------------------
# Backup
#-------------------------------------------------------------------------------

backup_retention_count = 7
backup_start_hour      = 3 # UTC

#-------------------------------------------------------------------------------
# Safety Controls
#
# deletion_protection = true — `terraform destroy` fails until you first
#   re-apply with -var="deletion_protection=false" (see ./README.md, Teardown).
#
# For throwaway / non-production environments, set deletion_protection = false
# so that `terraform destroy` completes in a single pass.
#-------------------------------------------------------------------------------

deletion_protection = true

# Password rotation is OFF. Nothing in this module rotates the database password
# on a schedule or automatically, and routine `terraform apply` runs leave it
# unchanged.
#
# Rotation is a deliberate, manual act: uncomment the line below and increment
# it. That regenerates the password, sends it to AlloyDB, and updates the Secret
# Manager entry — you must then copy the new value into your Helm values.yaml
# (secrets.postgres.password) and upgrade the release, or the application can no
# longer authenticate. Leave it commented out unless you are rotating right now.
# password_wo_version = 2
