{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "controlplane": {
      "type": "object",
      "properties": {
        "referenceData": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "gatewayUrl": {"type": "string", "maxLength": 2048},
            "timeoutSeconds": {"type": "integer", "minimum": 1}
          },
          "allOf": [
            {
              "if": {"required": ["enabled"], "properties": {"enabled": {"const": true}}},
              "then": {
                "required": ["gatewayUrl"],
                "properties": {
                  "gatewayUrl": {
                    "pattern": "^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:0*([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(/[^?#\\s]*)?$"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
